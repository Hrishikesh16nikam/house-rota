{
  "name": "house-rota",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Fair house duties as an installable app: plans the whole week so duties never collide, balances effort, handles absences and swaps, and sends free push reminders.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "build": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "local": "node scripts/dev.ts",
    "demo": "node scripts/demo.ts",
    "secrets": "node scripts/secrets.ts",
    "cf:db:create": "wrangler d1 create house-rota",
    "cf:db:migrate": "wrangler d1 migrations apply house-rota --remote",
    "cf:dev": "npm run build && wrangler d1 migrations apply house-rota --local && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wrangler": "^4.40.0"
  }
}
